---
# {{ ansible_managed }}
# Unified docker-compose for the *arr stack + jellyfin + qbittorrent
services:
  gluetun:
    image: qmcgaw/gluetun:latest
    container_name: gluetun
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    environment:
      TZ: {{ arr_timezone }}
      VPN_SERVICE_PROVIDER: custom
      VPN_TYPE: wireguard
      VPN_PORT_FORWARDING: "on"
      VPN_PORT_FORWARDING_PROVIDER: protonvpn
      VPN_PORT_FORWARDING_UP_COMMAND: >-
        /bin/sh -c 'wget -O- --retry-connrefused --post-data "json={\"listen_port\":{% raw %}{{PORTS}}{% endraw %},\"random_port\":false,\"upnp\":false}" http://127.0.0.1:{{ arr_qbittorrent_webui_port }}/api/v2/app/setPreferences 2>&1'
    volumes:
      - ./gluetun/wg0.conf:/gluetun/wireguard/wg0.conf:ro
    ports:
      - {{ arr_qbittorrent_webui_port }}:{{ arr_qbittorrent_webui_port }}
      - 9696:9696
    restart: unless-stopped

  jellyfin:
    image: jellyfin/jellyfin
    container_name: jellyfin
    ports:
      - 8096:8096/tcp
      - 7359:7359/udp
    volumes:
      - ./jellyfin/config:/config
      - ./jellyfin/cache:/cache
      - type: bind
        source: {{ arr_media_dir }}
        target: /media
    restart: 'unless-stopped'
    # Optional - may be necessary for docker healthcheck to pass if running in host network mode
    extra_hosts:
      - 'host.docker.internal:host-gateway'

  plex:
    image: linuxserver/plex:latest
    container_name: plex
    network_mode: host
    environment:
      - PUID={{ arr_puid }}
      - PGID={{ arr_pgid }}
      - TZ={{ arr_timezone }}
      - VERSION=docker
    volumes:
      - ./plex/config:/config
      - type: bind
        source: {{ arr_media_dir }}
        target: /media
    restart: unless-stopped

  sonarr:
    image: lscr.io/linuxserver/sonarr:latest
    container_name: sonarr
    environment:
      - PUID={{ arr_puid }}
      - PGID={{ arr_pgid }}
      - TZ={{ arr_timezone }}
    volumes:
      - ./sonarr/config:/config
      - {{ arr_media_dir }}/series:/series
      - {{ arr_downloads_dir }}:/downloads
    ports:
      - 8989:8989
    restart: unless-stopped

  radarr:
    image: lscr.io/linuxserver/radarr:latest
    container_name: radarr
    environment:
      - PUID={{ arr_puid }}
      - PGID={{ arr_pgid }}
      - TZ={{ arr_timezone }}
    volumes:
      - ./radarr/config:/config
      - {{ arr_media_dir }}/movies:/movies
      - {{ arr_downloads_dir }}:/downloads
    ports:
      - 7878:7878
    restart: unless-stopped

  prowlarr:
    image: lscr.io/linuxserver/prowlarr:latest
    container_name: prowlarr
    environment:
      - PUID={{ arr_puid }}
      - PGID={{ arr_pgid }}
      - TZ={{ arr_timezone }}
    volumes:
      - ./prowlarr:/config
    network_mode: "service:gluetun"
    depends_on:
      gluetun:
        condition: service_healthy
        restart: true
    restart: unless-stopped

  healarr:
    image: ghcr.io/mescon/healarr:latest
    container_name: healarr
    init: true
    environment:
      - PUID={{ arr_puid }}
      - PGID={{ arr_pgid }}
      - TZ={{ arr_timezone }}
      - HEALARR_DRY_RUN={{ arr_healarr_dry_run | lower }}
    volumes:
      - ./healarr/config:/config
      - {{ arr_media_dir }}/movies:/movies:ro
      - {{ arr_media_dir }}/series:/series:ro
    ports:
      - 3090:3090
    restart: unless-stopped

  cleanuparr:
    image: ghcr.io/cleanuparr/cleanuparr:latest
    container_name: cleanuparr
    environment:
      - PUID={{ arr_puid }}
      - PGID={{ arr_pgid }}
      - TZ={{ arr_timezone }}
      - PORT=11011
    volumes:
      - ./cleanuparr/config:/config
      - {{ arr_downloads_dir }}:/downloads
    ports:
      - 11011:11011
    restart: unless-stopped

  bazarr:
    image: lscr.io/linuxserver/bazarr:latest
    container_name: bazarr
    environment:
      - PUID={{ arr_puid }}
      - PGID={{ arr_pgid }}
      - TZ={{ arr_timezone }}
    volumes:
      - ./bazarr/config:/config
      - {{ arr_media_dir }}/movies:/movies
      - {{ arr_media_dir }}/series:/series
    ports:
      - 6767:6767
    restart:
      unless-stopped

  seerr:
    image: ghcr.io/seerr-team/seerr:latest
    init: true
    container_name: seerr
    environment:
      - PUID={{ arr_puid }}
      - PGID={{ arr_pgid }}
      - LOG_LEVEL=debug
      - TZ={{ arr_timezone }}
    ports:
      - 5055:5055
    volumes:
      - ./seerr/config:/app/config
    healthcheck:
      test: wget --no-verbose --tries=1 --spider http://localhost:5055/api/v1/status || exit 1
      start_period: 20s
      timeout: 3s
      interval: 15s
      retries: 3
    restart: unless-stopped

  qbittorrent:
    image: lscr.io/linuxserver/qbittorrent:latest
    container_name: qbittorrent
    environment:
      - PUID={{ arr_puid }}
      - PGID={{ arr_pgid }}
      - TZ={{ arr_timezone }}
      - WEBUI_PORT={{ arr_qbittorrent_webui_port }}
    volumes:
      - ./qbittorrent/config:/config
      - {{ arr_downloads_dir }}:/downloads
    network_mode: "service:gluetun"
    depends_on:
      gluetun:
        condition: service_healthy
        restart: true
    restart: unless-stopped
