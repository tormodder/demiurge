---
# {{ ansible_managed }}
# Unified docker-compose for the *arr stack + jellyfin + qbittorrent
services:
  jellyfin:
    image: jellyfin/jellyfin
    container_name: jellyfin
    ports:
      - 8096:8096/tcp
      - 7359:7359/udp
    volumes:
      - ./jellyfin/config:/config
      - ./jellyfin/cache:/cache
      - type: bind
        source: {{ arr_media_dir }}
        target: /media
    restart: 'unless-stopped'
    # Optional - may be necessary for docker healthcheck to pass if running in host network mode
    extra_hosts:
      - 'host.docker.internal:host-gateway'

  plex:
    image: linuxserver/plex:latest
    container_name: plex
    network_mode: host
    environment:
      - PUID={{ arr_puid }}
      - PGID={{ arr_pgid }}
      - TZ={{ arr_timezone }}
      - VERSION=docker
    volumes:
      - ./plex/config:/config
      - type: bind
        source: {{ arr_media_dir }}
        target: /media
    restart: unless-stopped

  sonarr:
    image: lscr.io/linuxserver/sonarr:latest
    container_name: sonarr
    environment:
      - PUID={{ arr_puid }}
      - PGID={{ arr_pgid }}
      - TZ={{ arr_timezone }}
    volumes:
      - ./sonarr/config:/config
      - {{ arr_media_dir }}/series:/series
      - {{ arr_downloads_dir }}:/downloads
    ports:
      - 8989:8989
    restart: unless-stopped

  radarr:
    image: lscr.io/linuxserver/radarr:latest
    container_name: radarr
    environment:
      - PUID={{ arr_puid }}
      - PGID={{ arr_pgid }}
      - TZ={{ arr_timezone }}
    volumes:
      - ./radarr/config:/config
      - {{ arr_media_dir }}/movies:/movies
      - {{ arr_downloads_dir }}:/downloads
    ports:
      - 7878:7878
    restart: unless-stopped

  prowlarr:
    image: lscr.io/linuxserver/prowlarr:latest
    container_name: prowlarr
    environment:
      - PUID={{ arr_puid }}
      - PGID={{ arr_pgid }}
      - TZ={{ arr_timezone }}
    volumes:
      - ./prowlarr:/config
    ports:
      - 9696:9696
    restart: unless-stopped

  bazarr:
    image: lscr.io/linuxserver/bazarr:latest
    container_name: bazarr
    environment:
      - PUID={{ arr_puid }}
      - PGID={{ arr_pgid }}
      - TZ={{ arr_timezone }}
    volumes:
      - ./bazarr/config:/config
      - {{ arr_media_dir }}/movies:/movies
      - {{ arr_media_dir }}/series:/series
    ports:
      - 6767:6767
    restart:
      unless-stopped

  seerr:
    image: ghcr.io/seerr-team/seerr:latest
    init: true
    container_name: seerr
    environment:
      - PUID={{ arr_puid }}
      - PGID={{ arr_pgid }}
      - LOG_LEVEL=debug
      - TZ={{ arr_timezone }}
    ports:
      - 5055:5055
    volumes:
      - ./seerr/config:/app/config
    healthcheck:
      test: wget --no-verbose --tries=1 --spider http://localhost:5055/api/v1/status || exit 1
      start_period: 20s
      timeout: 3s
      interval: 15s
      retries: 3
    restart: unless-stopped

  qbittorrent:
    image: lscr.io/linuxserver/qbittorrent:latest
    container_name: qbittorrent
    environment:
      - PUID={{ arr_puid }}
      - PGID={{ arr_pgid }}
      - TZ={{ arr_timezone }}
      - WEBUI_PORT={{ arr_qbittorrent_webui_port }}
      - TORRENTING_PORT={{ arr_qbittorrent_torrent_port }}
    volumes:
      - ./qbittorrent/config:/config
      - {{ arr_downloads_dir }}:/downloads
    ports:
      - {{ arr_qbittorrent_webui_port }}:{{ arr_qbittorrent_webui_port }}
      - {{ arr_qbittorrent_torrent_port }}:{{ arr_qbittorrent_torrent_port }}
      - {{ arr_qbittorrent_torrent_port }}:{{ arr_qbittorrent_torrent_port }}/udp
    restart: unless-stopped
